# Copia in .env e compila. Il file .env non va mai committato.

# --- WhatsApp Cloud API (Meta) — vedi README, "Setup Meta / WhatsApp" ---
# Token permanente del system user (o token temporaneo da 24h della pagina API Setup, solo per prove)
WHATSAPP_TOKEN=
# "Phone number ID" del numero che invia (pagina WhatsApp > API Setup); non è il numero di telefono
WHATSAPP_PHONE_NUMBER_ID=
# App settings > Basic > App secret: serve a verificare la firma X-Hub-Signature-256 dei webhook
WHATSAPP_APP_SECRET=
# Stringa a tua scelta, da inserire uguale nella configurazione del webhook su Meta
WHATSAPP_VERIFY_TOKEN=
# Versione della Graph API
WHATSAPP_API_VERSION=v25.0
# Template "utility" approvato in WhatsApp Manager per le notifiche oltre le 24 ore (vedi README)
WHATSAPP_ALERT_TEMPLATE=price_alert
WHATSAPP_TEMPLATE_LANG=it
# Numeri autorizzati a usare il bot (prefisso internazionale senza +, separati da virgola).
# Consigliato: il tuo numero, così nessun altro può usare il bot. Vuoto = nessun filtro.
ALLOWED_WA_IDS=393331234567

# --- Claude (riconoscimento della carta dalla foto) — https://platform.claude.com ---
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-5-5
# low | medium | high: più alto = lettura più accurata, più lenta e costosa
VISION_EFFORT=medium

# --- Dati ---
# Locale: SQLite. Produzione: la connection string di Neon così com'è, es.
# postgresql://utente:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./cardbot.db
TCGDEX_BASE_URL=https://api.tcgdex.net/v2
# Richieste al secondo massime verso TCGdex
TCGDEX_MAX_RPS=5
# Price guide pubblico Cardmarket (Pokémon), letto dal job giornaliero con richiesta condizionale (ETag)
CARDMARKET_PRICE_GUIDE_URL=https://downloads.s3.cardmarket.com/productCatalog/priceGuide/price_guide_6.json

# --- Bot ---
TIMEZONE=Europe/Rome
